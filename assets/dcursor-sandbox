profile dcursor_sandbox /usr/share/dcursor/resources/app/resources/helpers/cursorsandbox {
  file,
  /** ix,

  capability sys_admin,
  capability net_admin,
  capability chown,
  capability setuid,
  capability setgid,
  capability setpcap,
  network unix,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  signal (receive) peer=unconfined,

  mount,
  remount,
  umount,

  /usr/share/dcursor/resources/app/resources/helpers/cursorsandbox mr,
}

